{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp"
      },
      "drawio": {
        "type": "local",
        "command": [
          "/home/passla1/.local/nodejs/bin/node",
          "/home/passla1/.local/nodejs/lib/node_modules/npm/bin/npx-cli.js",
          "-y",
          "@drawio/mcp"
        ],
        "environment": {
          "PATH": "/home/passla1/.local/nodejs/bin:/usr/local/bin:/usr/bin:/bin"
        }
      },
      "google-docs": {
        "type": "local",
        "command": [
          "/home/passla1/.local/bin/google-docs-mcp"
        ],
        "environment": {
          "PATH": "/home/passla1/.local/nodejs/bin:/usr/local/bin:/usr/bin:/bin"
        }
      }
    }
  }
}