# Cloud database credentials — template only, safe to commit.
# Usage:
#   cp backend/.env.cloud.example backend/.env.cloud
#   Fill in the real values below, then run:
#   cd backend && .\run-cloud.ps1

SPRING_PROFILES_ACTIVE=cloud
DB_URL=jdbc:postgresql://YOUR_HOST:5432/rtms_db?sslmode=require
DB_USERNAME=YOUR_USERNAME
DB_PASSWORD=YOUR_PASSWORD
