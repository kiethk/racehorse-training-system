# Database (Matches docker-compose.yml)
POSTGRES_USER=rtms_user
POSTGRES_PASSWORD=rtms_password
POSTGRES_DB=rtms_db

# JWT Security
JWT_SECRET=rtms-secret-key-2026-doan-swp391-khong-duoc-de-lo-ra-ngoai-nhe

# Storage & HMAC Secret
APP_HMAC_SECRET=rtms-ai-agent-hmac-secret-key-2026-very-secure

# Cloudinary (Optional, leave blank to store uploads locally on disk)
CLOUDINARY_URL=

# Groq AI Provider (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=4096
